# Cache rules for what the build names by content hash. The Cloudflare adapter
# puts its own rule for /_astro/* ahead of these at build time (dist/client/_headers);
# these cover Pagefind, whose output it does not know about.
#
# The index chunks, fragments and meta file carry a content hash in their
# names and are never rewritten under the same name, so a browser may keep
# them for good: a new build names new files and pagefind-entry.json, which
# stays revalidating, points at them. The wasm file is not hashed, so it gets
# a week rather than a year. pagefind.js and the UI files are not hashed
# either and keep the default of revalidating on every request.
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/*.pf_meta
  Cache-Control: public, max-age=31536000, immutable
/pagefind/wasm.*.pagefind
  Cache-Control: public, max-age=604800
